# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=mirhago-super-secret-jwt-key-2024-change-in-production
JWT_EXPIRES_IN=7d

# Email Configuration
# Option 1: Brevo API (Recommended for Render)
BREVO_API_KEY=gWVD7IkUnhCQyXsP

# Option 2: Resend API
RESEND_API_KEY=your_resend_api_key_here

# Option 3: SMTP (Gmail/Others - Note: Render blocks ports)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

EMAIL_FROM=MirhalGO <mohamed.hassan221012@gmail.com>

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Business Logic
# ============================================
ENABLE_CRON_JOBS=true
OFFER_EXPIRY_HOURS=48
